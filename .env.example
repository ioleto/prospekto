APP_ENV=production
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DATABASE_URL=postgresql://prospekto:CHANGE_ME@db:5432/prospekto
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
# Fernet key for SMTP credential encryption; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_ARGON2_HASH
# Optional one-shot bootstrap secret; never persisted: ADMIN_PASSWORD_BOOTSTRAP=
SWAG_NETWORK=swag_default
DOMAIN=prospekto.ioleto.fr
CONNECTOR_ENABLED=false
MAMMOUTH_ENABLED=false
SMTP_ENABLED=false
